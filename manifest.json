{
  "name": "Opace Essential SEO Toolkit & SEO Audit Tool",
  "short_name": "SEO Toolkit",
  "version": "5.0.0",
  "author": "opace.agency",
  "description": "Run a private on-page SEO audit, then open verified free checks with the current page already supplied.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/get_started16.png",
      "32": "images/get_started32.png",
      "48": "images/get_started48.png",
      "128": "images/get_started128.png"
    }
  },
  "icons": {
    "16": "images/get_started16.png",
    "32": "images/get_started32.png",
    "48": "images/get_started48.png",
    "128": "images/get_started128.png"
  },
  "manifest_version": 3
}
